{
  "name": "bumps-results-tools",
  "private": true,
  "exports": {
    "./bumps": "./src/bumps.ts",
    "./club-history": "./src/club-history.ts",
    "./clubs": "./src/clubs.ts",
    "./results": "./src/results.ts",
    "./stats": "./src/stats.ts",
    "./tg-files": "./src/tg-files.ts",
    "./types": "./src/types.ts"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript/native-preview": "^7.0.0-dev.20260517.1",
    "prettier": "^3.8.3",
    "tsx": "^4.23.15",
    "vite": "^8",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@typescript/native-preview": "^7.0.0-dev",
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "@typescript/native-preview": {
      "optional": true
    }
  },
  "scripts": {
    "build": "pnpm run typecheck",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:ad": "tsx scripts/convert_tg_to_ad.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
