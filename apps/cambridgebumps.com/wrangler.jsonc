// An assets-only Cloudflare Worker: no Worker script, so Cloudflare serves
// `dist/` as static files. Workers Builds builds and deploys it from `main`,
// and uploads a preview version for every other branch. The Oxford site is a
// second Worker from the same config: `--env oxford`, built with SITE=oxford.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cambridgebumps",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Astro writes `about/index.html`; serve it at `/about` and redirect
    // `/about/` there: the URLs the site has always used.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "workers_dev": false,
  "preview_urls": true,
  "env": {
    "oxford": {
      "name": "oxfordbumps",
    },
  },
}
