---
import type { GetStaticPaths } from "astro";

import chartFontUrl from "@fontsource-variable/roboto-flex/files/roboto-flex-latin-grad-normal.woff2?url";

import { ChartsShell } from "@/components/charts-shell";
import type { YearFor } from "@/components/events-nav";
import { raceLabelsIn, raceNeighbours, racesIn, summary } from "@/data/results";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { slimRace } from "@/lib/slim-results";
import {
  chartPath,
  events,
  genders,
  getEventContext,
  getGenderLabel,
  nearestYear,
  raceTitle,
  type Gender,
  type EventKey,
} from "@/lib/utils";

export const getStaticPaths = (() => {
  // Also pre-generate the current year for every event/gender so that upcoming
  // events whose results aren't posted yet render the friendly "We have no
  // results to show for this year" message rather than a 404. (A static build
  // only serves paths returned here.) A year with two races (the early
  // mays/men years) has a page for each: see `chartPath`.
  const currentYear = String(new Date().getFullYear());

  return events.flatMap((event) =>
    genders.flatMap((gender) => {
      const years = summary[event][gender];
      const allYears = years.includes(currentYear)
        ? years
        : [...years, currentYear];

      return allYears.flatMap((year) => {
        const later = racesIn(event, gender, year).slice(1);
        return [undefined, ...later.map((_, index) => String(index + 2))].map(
          (race) => ({ params: { event, gender, year, race } }),
        );
      });
    }),
  );
}) satisfies GetStaticPaths;

const event = Astro.params.event as EventKey;
const gender = Astro.params.gender as Gender;
const year = Astro.params.year as string;
const race = Number(Astro.params.race ?? 1);

const years = summary[event][gender];
const races = racesIn(event, gender, year);

// "May" for "1838 May": what tells a year's two races apart. A year with one
// race has none.
const raceLabels = raceLabelsIn(event, gender, year);

// "May Bumps 1838 (March race)": the tab title's name for this race.
const title = raceTitle(event, year, raceLabels[race - 1]);

// The races either side of this one, for the heading's previous and next links.
const { previous, next } = raceNeighbours(event, gender, year, race);

// Years pre-generated without results yet (see `getStaticPaths`) render a
// friendly message and stay out of the index rather than being thin content.
// `slimRace` drops the per-crew flags the chart recomputes or reads only for
// truthiness; the year's results are serialised into the island's props, and
// Astro escapes every quote in them to `&quot;`, so each byte here costs six.
const result = races[race - 1];
const data = result && result.crews.length > 0 ? slimRace(result) : null;

// The "Highlight club" choices: every club racing that year.
const clubs = result
  ? [...new Set(result.crews.map((crew) => crew.club))].sort((a, b) =>
      a.localeCompare(b),
    )
  : [];

// Where each event/category link from this page lands: this year if that
// event/category raced it, otherwise its nearest year that did — so switching
// from May Bumps 1900 to Women goes to 1974 rather than a 404.
const yearFor = Object.fromEntries(
  events.map((e) => [
    e,
    Object.fromEntries(
      genders.map((g) => [g, nearestYear(summary[e][g], year) ?? year]),
    ),
  ]),
) as YearFor;

const genderName = getGenderLabel(event, gender);

// The Town Bumps results for the current year are unofficial until the CRA
// publishes theirs.
const showCraNotice = event === "town" && year === years[years.length - 1];
---

<BaseLayout
  title={`${title} - ${genderName}`}
  description={`${title} bumps chart (${genderName}). View race results, daily positions, and bumps for all ${getEventContext(event)} crews.`}
  canonical={chartPath(event, gender, year, race)}
  noindex={data === null}
>
  {/*
      The chart is in the HTML, so it paints before its font would otherwise
      be requested. Until the font arrives the names draw in Arial, ~3% wider
      than the Roboto Flex columns `measureChartText` sizes them for.
    */}
  {data && (
    <link
      slot="head"
      rel="preload"
      href={chartFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
  )}
  <ChartsShell
    client:load
    transition:persist="charts-shell"
    event={event}
    gender={gender}
    year={year}
    race={race}
    raceLabels={raceLabels}
    previous={previous}
    next={next}
    years={years}
    yearFor={yearFor}
    clubs={clubs}
    data={data}
    showCraNotice={showCraNotice}
  />
</BaseLayout>
