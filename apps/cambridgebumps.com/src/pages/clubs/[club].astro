---
import type { GetStaticPaths } from "astro";
import { Blade } from "react-rowing-blades";

import ClubPositionChart from "@/components/ClubPositionChart.astro";
import { homeCity, siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  clubsIn,
  getClubHistory,
  getSectionRecords,
  latestYear,
  type ClubRace,
  type ClubSection,
  type CrewResult,
  type CrewYear,
} from "@/lib/club-history";
import { getCode, getGenderLabel, set, yearOf } from "@/lib/utils";

export const getStaticPaths = (() =>
  clubsIn(homeCity).map((club) => ({
    params: { club: club.slug },
    props: { club },
  }))) satisfies GetStaticPaths;

const { club } = Astro.props;
const history = getClubHistory(club);

const sections = history.sections.map((section) => ({
  section,
  records: getSectionRecords(section),
  id: `${section.event}-${section.gender}`,
  title: `${set[section.event]} · ${getGenderLabel(section.event, section.gender)}`,
}));

const ordinal = (n: number) => {
  if (n === 1) return "Head";
  const tens = n % 100;
  const suffix =
    tens >= 11 && tens <= 13
      ? "th"
      : (({ 1: "st", 2: "nd", 3: "rd" } as Record<number, string>)[n % 10] ??
        "th");
  return `${n}${suffix}`;
};

const formatGain = (gain: number | null) =>
  gain === null
    ? "Withdrew"
    : gain > 0
      ? `+${gain}`
      : gain < 0
        ? `−${-gain}`
        : "0";

const notes = (crew: CrewResult) =>
  [
    crew.head && "Head",
    crew.blades && "Blades",
    crew.spoons && "Spoons",
  ].filter(Boolean) as string[];

const describe = (crew: CrewResult) =>
  (crew.finish === null
    ? `started ${ordinal(crew.start).toLowerCase()}, withdrew`
    : `${ordinal(crew.start)} → ${ordinal(crew.finish)} (${formatGain(crew.gain)})`) +
  (notes(crew).length > 0 ? ` · ${notes(crew).join(", ")}` : "");

const chartHref = (section: ClubSection, year: string, crew: CrewResult) =>
  `/charts/${section.event}/${section.gender}/${yearOf(year)}?club=${encodeURIComponent(crew.club)}`;

// The year-by-year grid: a row for each decade, newest first, and a cell for
// each year from the club's first race to its last. A cell gives the 1st
// boat's result; a year with two races (the early Mays) shows the later, as
// the chart does. Decades the event never raced in are left out.
type Tone = "up-1" | "up-2" | "up-3" | "down-1" | "down-2" | "down-3";
type GridCell =
  | {
      kind: "result";
      label: string;
      tone: Tone | "level" | "head" | "withdrew";
      href: string;
      title: string;
    }
  | { kind: "absent"; title: string }
  | null;

const toneOf = (gain: number): Tone => {
  const size = Math.abs(gain) >= 4 ? 3 : Math.abs(gain) >= 2 ? 2 : 1;
  return `${gain > 0 ? "up" : "down"}-${size}`;
};

const decadeRows = (section: ClubSection) => {
  const held = new Set(section.years.map(yearOf));
  const racesIn = new Map<number, ClubRace[]>();
  for (const race of section.races) {
    const year = yearOf(race.year);
    racesIn.set(year, [...(racesIn.get(year) ?? []), race]);
  }
  const first = yearOf(section.races[0].year);
  const last = yearOf(section.races[section.races.length - 1].year);

  const cellFor = (year: number): GridCell => {
    if (year < first || year > last || !held.has(year)) return null;
    const races = racesIn.get(year);
    if (!races) return { kind: "absent", title: `${year}: didn't race` };

    const leading = (race: ClubRace) =>
      race.crews.find((crew) => crew.number === 1) ?? race.crews[0];
    const race = races[races.length - 1];
    const crew = leading(race);
    return {
      kind: "result",
      label: crew.head ? "H" : crew.gain === null ? "W" : formatGain(crew.gain),
      tone: crew.head
        ? "head"
        : crew.gain === null
          ? "withdrew"
          : crew.gain === 0
            ? "level"
            : toneOf(crew.gain),
      href: chartHref(section, race.year, crew),
      title: races
        .map(
          (race) =>
            `${race.year}: ${leading(race).name}, ${describe(leading(race))}`,
        )
        .join("\n"),
    };
  };

  const rows = [];
  for (
    let decade = last - (last % 10);
    decade >= first - (first % 10);
    decade -= 10
  ) {
    const years = Array.from({ length: 10 }, (_, i) => decade + i);
    if (!years.some((year) => held.has(year))) continue;
    rows.push({ decade, cells: years.map(cellFor) });
  }
  return rows;
};

const gridLegend: { label: string; tone: string; text?: string }[] = [
  { label: "−4", tone: "down-3" },
  { label: "−2", tone: "down-2" },
  { label: "−1", tone: "down-1" },
  { label: "0", tone: "level" },
  { label: "+1", tone: "up-1" },
  { label: "+2", tone: "up-2" },
  { label: "+4", tone: "up-3", text: "places" },
  { label: "H", tone: "head", text: "head" },
  { label: "W", tone: "withdrew", text: "withdrew" },
  { label: "·", tone: "absent", text: "didn't race" },
];

// "1972, 1975 and 4 more"
const listYears = (races: CrewYear[], most = 6) => {
  const years = [...new Set(races.map(({ year }) => String(yearOf(year))))];
  const shown = years.slice(0, most).join(", ");
  return years.length > most
    ? `${shown} and ${years.length - most} more`
    : shown;
};

const code = getCode(club.short, history.sections[0].event);

// Where the club raced, for the subtitle and description: "Lent Bumps since
// 1887, May Bumps since 1827".
const eventSpans = [...new Set(history.sections.map(({ event }) => event))].map(
  (event) => {
    const firsts = sections
      .filter(({ section }) => section.event === event)
      .map(({ records }) => yearOf(records.firstYear));
    return `${set[event]} since ${Math.min(...firsts)}`;
  },
);

const headshipSummary = sections
  .filter(({ records }) => records.headships.length > 0)
  .map(
    ({ section, records }) =>
      `${records.headships.length} ${set[section.event]} headship${records.headships.length === 1 ? "" : "s"} (${getGenderLabel(section.event, section.gender)})`,
  );

const title = club.name.includes(club.short)
  ? `${club.name} - Bumps History`
  : `${club.name} (${club.short}) - Bumps History`;

const description = [
  `${club.name}'s bumps history: ${new Intl.ListFormat("en-GB").format(eventSpans)}.`,
  headshipSummary.length > 0 &&
    `${new Intl.ListFormat("en-GB").format(headshipSummary)}.`,
  "Year-by-year results, records and finishing positions for every crew.",
]
  .filter(Boolean)
  .join(" ");

const canonical = `/clubs/${club.slug}`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SportsOrganization",
  name: club.name,
  alternateName: club.short,
  sport: "Rowing",
  url: new URL(canonical, siteConfig.url).href,
  location: { "@type": "City", name: club.city },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
  <div class="relative container">
    <section>
      <div class="mx-auto px-4 pb-12 sm:px-6 md:px-8 lg:px-12">
        <header class="flex items-center gap-4 pt-4">
          {code && <Blade club={code} size={72} />}
          <div>
            <h1 class="scroll-m-20 text-3xl font-bold tracking-tight lg:text-4xl">
              {club.name}
            </h1>
            <p class="mt-1 text-muted-foreground">{eventSpans.join(" · ")}</p>
          </div>
        </header>

        {sections.length > 1 && (
          <nav class="mt-6 flex flex-wrap gap-2 text-sm" aria-label="Sections">
            {sections.map(({ id, title }) => (
              <a
                href={`#${id}`}
                class="rounded-md border px-3 py-1 transition-colors hover:bg-muted"
              >
                {title}
              </a>
            ))}
          </nav>
        )}

        {sections.map(({ section, records, id, title }) => {
          const latest = latestYear(section);

          return (
            <section id={id} class="mt-10 scroll-mt-20">
              <h2 class="text-2xl font-bold tracking-tight">{title}</h2>

              <dl class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
                <div>
                  <dt class="text-sm text-muted-foreground">Headships</dt>
                  <dd class="text-2xl font-semibold">
                    {records.headships.length}
                  </dd>
                  {records.headships.length > 0 && (
                    <dd class="text-sm text-muted-foreground">
                      {listYears(records.headships)}
                    </dd>
                  )}
                </div>
                <div>
                  <dt class="text-sm text-muted-foreground">Highest finish</dt>
                  <dd class="text-2xl font-semibold">
                    {ordinal(records.highest.position)}
                  </dd>
                  {records.highest.position > 1 && (
                    <dd class="text-sm text-muted-foreground">
                      {listYears(records.highest.races, 3)}
                    </dd>
                  )}
                </div>
                <div>
                  <dt class="text-sm text-muted-foreground">Blades</dt>
                  <dd class="text-2xl font-semibold">{records.blades}</dd>
                </div>
                <div>
                  <dt class="text-sm text-muted-foreground">Spoons</dt>
                  <dd class="text-2xl font-semibold">{records.spoons}</dd>
                </div>
                <div>
                  <dt class="text-sm text-muted-foreground">First raced</dt>
                  <dd class="text-2xl font-semibold">
                    {yearOf(records.firstYear)}
                  </dd>
                </div>
              </dl>

              <ClubPositionChart club={club} section={section} />

              <div class="mt-6 grid gap-8 md:grid-cols-2">
                <div>
                  <h3 class="text-lg font-semibold">
                    {records.current.length > 0
                      ? `${yearOf(latest)} crews`
                      : "Last raced"}
                  </h3>
                  {records.current.length > 0 ? (
                    <ul class="mt-2 space-y-1">
                      {records.current.map((crew) => (
                        <li>
                          <a
                            href={chartHref(section, latest, crew)}
                            class="underline decoration-border underline-offset-4 hover:decoration-current"
                          >
                            {crew.name}
                          </a>
                          <span class="text-muted-foreground">
                            {" "}
                            {describe(crew)}
                          </span>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="mt-2 text-muted-foreground">
                      {yearOf(records.lastYear)}
                    </p>
                  )}
                </div>

                {(records.rises.length > 0 || records.falls.length > 0) && (
                  <div>
                    <h3 class="text-lg font-semibold">Best and worst years</h3>
                    <ul class="mt-2 space-y-1">
                      {[...records.rises, ...records.falls].map(
                        ({ year, crew }) => (
                          <li>
                            <span class="inline-block w-10 font-medium tabular-nums">
                              {formatGain(crew.gain)}
                            </span>
                            <a
                              href={chartHref(section, year, crew)}
                              class="underline decoration-border underline-offset-4 hover:decoration-current"
                            >
                              {crew.name}, {yearOf(year)}
                            </a>
                          </li>
                        ),
                      )}
                    </ul>
                  </div>
                )}
              </div>

              <h3 class="mt-8 text-lg font-semibold">Year by year</h3>
              <p class="mt-1 text-sm text-muted-foreground">
                The 1st boat's result each year. Each year links to its chart.
              </p>
              <ul class="year-grid-legend mt-3" aria-hidden="true">
                {gridLegend.map(({ label, tone, text }) => (
                  <li>
                    <span data-tone={tone}>{label}</span>
                    {text}
                  </li>
                ))}
              </ul>
              {/* Styled from the table, not cell by cell: a club's oldest
                  section runs to about 250 cells. */}
              <table class="year-grid mt-3">
                <thead>
                  <tr>
                    <th>
                      <span class="sr-only">Decade</span>
                    </th>
                    {Array.from({ length: 10 }, (_, i) => (
                      <th scope="col">{i}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {decadeRows(section).map(({ decade, cells }) => (
                    <tr>
                      <th scope="row">{decade}s</th>
                      {cells.map((cell) => (
                        <td>
                          {cell?.kind === "result" ? (
                            <a
                              href={cell.href}
                              title={cell.title}
                              data-tone={cell.tone}
                            >
                              {cell.label}
                            </a>
                          ) : cell?.kind === "absent" ? (
                            <span title={cell.title} data-tone="absent">
                              ·
                            </span>
                          ) : null}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Places gained in blue, lost in red: the poles of a diverging scale, which
     unlike green and red stay apart for colour-blind readers. Text stays in
     the page's ink; the sign carries the direction too. */
  .year-grid,
  .year-grid-legend {
    --up: #2a78d6;
    --down: #e34948;
  }
  :global(.dark) .year-grid,
  :global(.dark) .year-grid-legend {
    --up: #3987e5;
    --down: #e66767;
  }

  .year-grid {
    width: 100%;
    max-width: 36rem;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 2px;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .year-grid th {
    font-weight: 400;
    color: var(--muted-foreground);
  }
  .year-grid thead th:first-child,
  .year-grid tbody th {
    width: 3.25rem;
    text-align: left;
  }

  [data-tone] {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.75rem;
    border-radius: 4px;
    color: var(--foreground);
  }
  .year-grid a:hover,
  .year-grid a:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: -2px;
  }
  [data-tone="up-1"] {
    background: color-mix(in oklab, var(--up) 22%, transparent);
  }
  [data-tone="up-2"] {
    background: color-mix(in oklab, var(--up) 45%, transparent);
  }
  [data-tone="up-3"] {
    background: color-mix(in oklab, var(--up) 70%, transparent);
  }
  [data-tone="down-1"] {
    background: color-mix(in oklab, var(--down) 22%, transparent);
  }
  [data-tone="down-2"] {
    background: color-mix(in oklab, var(--down) 45%, transparent);
  }
  [data-tone="down-3"] {
    background: color-mix(in oklab, var(--down) 70%, transparent);
  }
  [data-tone="level"] {
    background: var(--muted);
  }
  [data-tone="head"] {
    box-shadow: inset 0 0 0 1.5px var(--foreground);
    font-weight: 600;
  }
  [data-tone="withdrew"],
  [data-tone="absent"] {
    color: var(--muted-foreground);
  }

  .year-grid-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }
  .year-grid-legend li {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .year-grid-legend [data-tone] {
    width: 1.75rem;
    font-variant-numeric: tabular-nums;
  }
</style>
