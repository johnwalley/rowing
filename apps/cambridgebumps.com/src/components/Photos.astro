---
import { Image } from "astro:assets";

import PhotoCredit from "@/components/PhotoCredit.astro";
import { homePhotos as images } from "@/config/photos";

const credited = images.flatMap((image) => image.credit ?? []);

const middle = Math.floor(images.length / 2);

const rotations = [
  "rotate-2",
  "-rotate-2",
  "rotate-2",
  "rotate-2",
  "-rotate-2",
];
---

{/*
    The strip is wider than the viewport below ~1600px, so it scrolls
    sideways (snapping card to card) rather than clipping the outer photos.
    `justify-center-safe` centres it when it fits and falls back to the start
    when it doesn't — plain `justify-center` would push the first card out to
    the left, where a scroll container can't reach it. The script below then
    starts it scrolled to the middle, so it opens looking as it did when it
    was clipped. The vertical padding leaves room for the rotated corners,
    which the scroll container would otherwise clip.
  */}
<div
  id="home-photos"
  tabindex="0"
  role="region"
  aria-label="Photos"
  class="-my-4 -mr-4 -ml-4 flex w-[calc(100%+2rem)] snap-x snap-mandatory justify-center-safe gap-5 overflow-x-auto overscroll-x-contain px-4 py-4 [scrollbar-width:none] focus-visible:outline-2 focus-visible:outline-ring sm:-mr-8 sm:-ml-8 sm:w-[calc(100%+4rem)] sm:gap-8 sm:px-8 [&::-webkit-scrollbar]:hidden"
>
  {images.map((image, index) => (
    <div
      class:list={[
        "relative aspect-[9/10] w-44 flex-none snap-center overflow-hidden rounded-xl bg-zinc-100 sm:w-72 sm:rounded-2xl dark:bg-zinc-800",
        rotations[index % rotations.length],
      ]}
    >
      {/*
          The card is a 9:10 portrait but the photos are landscape, so
          `object-cover` scales each one to ~2x the card's width and crops the
          sides off. `sizes` therefore doubles the card width (18rem -> 36rem,
          11rem -> 22rem) — the browser only knows the element's layout width
          and would otherwise pick a candidate half the resolution it needs.
        */}
      {/*
          Loading all five eagerly at high priority pulled ~550 KB of
          decorative photos in front of everything else on a 2x display. The
          strip opens on its middle, so on a phone only the middle three cards
          are on screen; the outer two are lazy, fetched once it's scrolled
          towards them (a wide viewport shows all five a beat later).
        */}
      <Image
        src={image.src}
        alt={image.alt}
        widths={[352, 576, 704, 1152]}
        sizes="(min-width: 640px) 36rem, 22rem"
        quality={75}
        loading={Math.abs(index - middle) <= 1 ? "eager" : "lazy"}
        fetchpriority={index === middle ? "high" : "auto"}
        decoding={index === middle ? "sync" : "async"}
        class="absolute inset-0 h-full w-full object-cover"
      />
    </div>
  ))}
</div>
{/* Inline so it runs before the first paint, and again after each ClientRouter swap. */}
<script is:inline>
  {
    const strip = document.getElementById("home-photos");
    if (strip) strip.scrollLeft = (strip.scrollWidth - strip.clientWidth) / 2;
  }
</script>
{credited.length > 0 && (
  <p class="mt-6 text-center text-xs text-balance text-muted-foreground [&_a]:underline [&_a]:underline-offset-2">
    Photos from Wikimedia Commons, from left:{" "}
    {credited.map((credit, index) => (
      <>
        {index > 0 && "; "}
        <PhotoCredit credit={credit} />
      </>
    ))}
  </p>
)}
