{
  "framework": "astro",
  "buildCommand": "pnpm --filter cambridgebumps.com... --filter '!bumps-results-tools' run build",
  "headers": [
    {
      "source": "/data/results/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
