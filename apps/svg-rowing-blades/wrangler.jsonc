// An assets-only Cloudflare Worker: no Worker script, so Cloudflare serves
// `dist/` as static files. Workers Builds builds and deploys it from `main`,
// and uploads a preview version for every other branch.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "svg-rowing-blades",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Astro writes `club/usa/index.html`; serve it at `/club/usa` and
    // redirect `/club/usa/` there, as Vercel did.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "workers_dev": false,
  "preview_urls": true,
}
