---
import Layout from "../layouts/Layout.astro";

const faqs = [
  {
    question: "I can't find the blade I'm looking for?",
    answer: "Let us know and we might be able to add it as a new design.",
  },
  // More questions...
];
---

<Layout title="SVG Rowing Blades | About">
  <div class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <div class="mx-auto max-w-3xl divide-y-2 divide-gray-200">
        <h2 class="pb-6 text-center text-3xl font-extrabold text-gray-900 sm:text-4xl">
          Frequently asked questions
        </h2>
        <div class="space-y-6 divide-y divide-gray-200">
          {faqs.map((faq) => (
            <details class="group pt-6">
              <summary class="flex w-full cursor-pointer list-none items-start justify-between text-left text-lg text-gray-400 [&::-webkit-details-marker]:hidden">
                <span class="font-medium text-gray-900">{faq.question}</span>
                <span class="ml-6 flex h-7 items-center">
                  <svg
                    class="h-6 w-6 rotate-0 group-open:-rotate-180"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m19.5 8.25-7.5 7.5-7.5-7.5"
                    ></path>
                  </svg>
                </span>
              </summary>
              <p class="mt-2 pr-12 text-base text-gray-500">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>
